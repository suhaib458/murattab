# Gemini API Key for server-side smart schedule extraction (Server-only)
GEMINI_API_KEY=
# Gemini Model ID (Server-only, defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
# Overall budget (ms) for the entire extract() call — covers all retry
# attempts AND inter-attempt backoff sleeps. Must be long enough for the
# 3-attempt retry policy to actually run. Default 60000. Server-only.
AI_PROVIDER_TIMEOUT_MS=60000
