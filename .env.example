# Optional anonymous product analytics (PostHog).
# The project token is publishable and safe to expose in NEXT_PUBLIC_*.
# Leave NEXT_PUBLIC_POSTHOG_KEY empty to disable product-event tracking completely.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Gemini API key for server-side smart schedule extraction.
# Keep this secret. Do not expose it through NEXT_PUBLIC_* variables.
GEMINI_API_KEY=

# Primary Gemini vision-capable model used for schedule extraction.
# Current default in code: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Automatic fallback models used only after transient provider failures
# such as 408, 429, 500, 502, 503, or 504.
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
GEMINI_SECONDARY_FALLBACK_MODEL=gemini-3.6-flash

# Total provider budget for one extraction request.
# Kept below Vercel's 60-second execution ceiling.
AI_PROVIDER_TIMEOUT_MS=50000

# Rollback reference only (currently unused by Smart Import):
# XKIRO_API_KEY=
# XKIRO_MODEL=qwen/qwen3.8-max:free

# Anonymous Smart Import guardrails.
# These defaults reduce accidental/burst API usage while keeping normal retries usable.
AI_CLIENT_RATE_LIMIT_REQUESTS=3
AI_CLIENT_RATE_LIMIT_WINDOW_MS=600000

# Soft per-instance burst guard kept below the current 5 RPM free-tier model limit.
# Vercel may run more than one function instance, so this is a safety layer rather
# than a globally distributed quota.
AI_GLOBAL_RATE_LIMIT_REQUESTS=4
AI_GLOBAL_RATE_LIMIT_WINDOW_MS=60000

# Exact-file result cache. Only the parsed extraction result is cached in warm
# server memory; raw uploaded bytes are not retained.
AI_RESULT_CACHE_TTL_MS=3600000
AI_RESULT_CACHE_MAX_ENTRIES=100
