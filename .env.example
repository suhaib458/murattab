# xKiro API Key for server-side smart schedule extraction (Server-only)
XKIRO_API_KEY=
# xKiro Model ID (Server-only, defaults to qwen/qwen3.8-omni-flash:free)
XKIRO_MODEL=qwen/qwen3.8-omni-flash:free
# Total overall budget (ms) for the entire extract() call — covers PDF rasterization,
# all retry attempts, and inter-attempt backoff sleeps. Bounded below Vercel's 60s hard limit.
# Default 50000. Server-only.
AI_PROVIDER_TIMEOUT_MS=50000

# Rollback Reference: Legacy Google Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
